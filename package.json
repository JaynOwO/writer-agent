{
  "name": "writer-agent",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "description": "Siglum: local-first writing workflows, bounded tools and traceable evidence",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "demo": "node scripts/demo.mjs",
    "writer": "node apps/cli/dist/index.js",
    "demo:provider": "node scripts/provider-demo.mjs",
    "siglum": "node apps/cli/dist/index.js",
    "demo:sources": "node scripts/sources-demo.mjs",
    "docs:check": "node scripts/check-readme-parity.mjs",
    "demo:review": "node scripts/review-demo.mjs",
    "eval:score": "node scripts/score-review-eval.mjs",
    "demo:memory": "node scripts/memory-demo.mjs",
    "demo:workflow": "node scripts/workflow-demo.mjs",
    "demo:extensions": "node scripts/extensions-demo.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "demo:product": "node scripts/product-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.8.3"
  }
}
